+check("DPI scale-invariant", abs(td_lp.dpi - td_fund.dpi) < 1e-12, f"{td_lp.dpi} vs {td_fund.dpi}")
+check("RVPI scale-invariant", abs(td_lp.rvpi - td_fund.rvpi) < 1e-12)
