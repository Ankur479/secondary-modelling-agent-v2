+
+
+# ===========================================================================
+print("\n--- 2. Unfunded commitment generates its own return ---")
+# ===========================================================================
+forecast_rows_5y = [{"year": y, "date": date(2026 + y, 9, 2), "gross_distribution": 1_000_000.0}
+                     for y in range(1, 6)]
+unfunded_calls = {1: 100_000.0, 2: 25_000.0, 3: 0.0, 4: 0.0, 5: 0.0}
